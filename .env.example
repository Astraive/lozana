# Lozana Environment Variables
#
# Localhost-only defaults are plaintext for development. For any non-loopback
# deployment use https:// / wss:// and list the API origins explicitly.
# These values are embedded in the public JS bundle at build time — never put secrets here.
# The collector API key is entered in the Settings page at runtime and kept in sessionStorage.
VITE_LOZANA_API_URL=http://localhost:9308
VITE_LOZANA_WS_URL=ws://localhost:9308
# Server-only: consumed by the Vite dev proxy to add the Authorization header.
# Never give a secret a VITE_ prefix — VITE_* values are inlined into the browser bundle.
LOZA_API_KEY=
VITE_CORTEX_URL=http://localhost:9312
VITE_WS_URL=ws://localhost:9308/ws/tail
VITE_LOZA_API_KEY=

# Comma-separated allowlist of non-loopback API origins (scheme ignored,
# host:port compared). Same-origin dashboard deployments need no entry.
# Example: VITE_LOZANA_ALLOWED_ORIGINS=https://api.example.com,https://cortex.example.com:9312
VITE_LOZANA_ALLOWED_ORIGINS=
# Collector token is entered on the /settings page (browser-session only),
# not read from this file at runtime.
VITE_LOZA_API_KEY=
